# =============================================================================
# Safepay environment variables
# Copy to .env.local for local development. Never commit real secrets.
# =============================================================================

# --- Public client variables (VITE_ vars are inlined into the browser bundle
# --- at build time, so they are visible to users by design). Both are required
# --- on Netlify so the frontend talks to the correct Supabase project.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Optional: production domain for the build-time robots.txt / sitemap.xml
# generator (scripts/emit-site-files.mjs). Falls back to the committed
# template domain when unset. Set on Netlify to your production URL, e.g.
# SITE_URL=https://your-app.netlify.app
# SITE_URL=

# =============================================================================
# Local-only server-side secrets. These are used exclusively by local scripts
# (scripts/db-query.mjs, scripts/apply-migrations.mjs, the audit tooling).
# Do NOT set them in Netlify and never prefix them with VITE_ or they will be
# shipped to the browser. Keep them only in your local .env.local.
# =============================================================================
SUPABASE_DB_HOST=db.YOUR-PROJECT-REF.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
